# Identity-preserving overlay for the verified public Q6 worker.
# The workflow builds the payload directory before invoking Docker so all
# changed runtime files land in one small layer beside the known-good image.
ARG BASE_IMAGE=ghcr.io/the-faceless-dev/faceless-wan-animate-worker:wan-q6-salad-20260826-r7
FROM ${BASE_IMAGE}

USER root

# RTX 5090 test profile. The request may override this value, but production
# jobs use the stronger identity anchor unless they explicitly opt out.
ENV GENERATIVE_DANCE_WAN_REFERENCE_STRENGTH=1.25

# payload/app mirrors the destination paths, so this remains one overlay layer.
COPY payload/ /

USER wan
