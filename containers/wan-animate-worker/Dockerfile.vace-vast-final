# syntax=docker/dockerfile:1.7

# Final combined Vast image: the tested Wan Animate memory image plus the
# VACE overlay and the already-built optional quality-stage payloads.
ARG BASE_IMAGE=ghcr.io/the-faceless-dev/faceless-wan-animate-worker:wan-q6-vast-direct-20260904-block-offload-vace14b-r1
ARG QUALITY_IMAGE=ghcr.io/the-faceless-dev/faceless-wan-vace-stitch-worker:vace13b-20260829-quality-rife9

FROM ${QUALITY_IMAGE} AS quality-payload

FROM ${BASE_IMAGE}

USER root

RUN mkdir -p \
      /opt/rife/vfi_models/rife \
      /models/rife \
      /models/realesrgan \
      /app/tools/vace_stitch \
      /app/src/autotransition/vace_stitch \
      /app/src/autotransition/generative_dance

# Reuse only the quality-stage payload from the prior public VACE image. The
# VACE checkpoint itself remains the 14B payload in BASE_IMAGE.
COPY --from=quality-payload /opt/rife/vfi_models/rife /opt/rife/vfi_models/rife
COPY --from=quality-payload /models/rife/rife49.pth /models/rife/rife49.pth
COPY --from=quality-payload /models/realesrgan/RealESRGAN_x2plus.pth /models/realesrgan/RealESRGAN_x2plus.pth

COPY tools/vace_stitch/realesrgan_stage.py /app/tools/vace_stitch/realesrgan_stage.py
COPY tools/vace_stitch/rife_stage.py /app/tools/vace_stitch/rife_stage.py
COPY src/autotransition/vace_stitch/enhancement.py /app/src/autotransition/vace_stitch/enhancement.py
COPY src/autotransition/vace_stitch/config.py /app/src/autotransition/vace_stitch/config.py
COPY src/autotransition/vace_stitch/worker.py /app/src/autotransition/vace_stitch/worker.py
COPY src/autotransition/generative_dance/video.py /app/src/autotransition/generative_dance/video.py

RUN python -m pip install --no-cache-dir --no-deps \
      "basicsr==1.4.2" \
      "realesrgan==0.3.0" \
      "yapf<0.41" \
    && python -m py_compile \
      /app/tools/vace_stitch/realesrgan_stage.py \
      /app/tools/vace_stitch/rife_stage.py \
      /app/src/autotransition/vace_stitch/enhancement.py \
      /app/src/autotransition/vace_stitch/config.py \
      /app/src/autotransition/vace_stitch/worker.py \
      /app/src/autotransition/generative_dance/video.py \
    && test -s /models/rife/rife49.pth \
    && test -s /models/realesrgan/RealESRGAN_x2plus.pth \
    && test -s /opt/rife/vfi_models/rife/rife_arch.py

# Keep both stages optional at runtime. Launcher/job parameters can enable them
# without rebuilding this image, and the commands point only to payloads in
# this image rather than depending on a separate worker.
ENV VACE_STITCH_ENHANCEMENT_ENABLED=false \
    VACE_STITCH_ENHANCEMENT_BACKEND=realesrgan \
    VACE_STITCH_ENHANCEMENT_SCALE=2 \
    VACE_STITCH_ENHANCEMENT_TILE_SIZE=512 \
    VACE_STITCH_ENHANCEMENT_FP16=true \
    VACE_STITCH_ENHANCEMENT_COMMAND="python /app/tools/vace_stitch/realesrgan_stage.py --input {input} --output {output} --model /models/realesrgan/RealESRGAN_x2plus.pth --scale {scale} --tile-size {tile_size} --fp16" \
    VACE_STITCH_MOTION_INTERPOLATION_ENABLED=false \
    VACE_STITCH_MOTION_INTERPOLATION_BACKEND=rife \
    VACE_STITCH_MOTION_INTERPOLATION_TARGET_FPS=48 \
    VACE_STITCH_MOTION_INTERPOLATION_COMMAND="python /app/tools/vace_stitch/rife_stage.py --input {input} --output {output} --source-root /opt/rife --checkpoint /models/rife/rife49.pth --target-fps {target_fps}"

USER wan
