# Private production image overlay. Model files are provisioned into the final
# image outside git after this dependency layer is built.
FROM ghcr.io/the-faceless-dev/faceless-avatar-worker@sha256:7f7bcf9dcf61802bb457bc1fd0163b97a3dcea03ff5103642f84aa174e9731d1

ARG SKINTOKENS_COMMIT=273b691d35989d71cd17ff2895fdc735097b92d1

USER root

WORKDIR /app
COPY src ./src
COPY tools ./tools
COPY pyproject.toml README.md ./
COPY containers/avatar-worker/faceless-avatar-entrypoint.sh /app/faceless-avatar-entrypoint.sh
RUN chmod 0755 /app/faceless-avatar-entrypoint.sh

# SkinTokens imports OpenCV during rigging; keep the runtime image headless
# while providing the shared libraries required by cv2.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/VAST-AI-Research/SkinTokens.git /opt/SkinTokens \
    && git -C /opt/SkinTokens checkout --detach "${SKINTOKENS_COMMIT}" \
    && python -m pip install --no-cache-dir -r /opt/SkinTokens/requirements.txt \
    && rm -rf /opt/SkinTokens/.git

ENV AVATAR_GPU_REQUIRED=1 \
    AVATAR_IMAGE_COMMAND="python /app/tools/avatar/flux2_klein_generate.py --prompt-file {prompt_file} --negative-prompt-file {negative_prompt_file} --output {output} --seed {seed} --reference-image {reference_image}" \
    AVATAR_MESH_COMMAND="python /app/tools/avatar/trellis2_generate.py --image {image} --output-dir {output_dir} --output {output} --quality {quality}" \
    AVATAR_RIG_COMMAND="python /app/tools/avatar/rig_runner.py --skintokens-repo /models/SkinTokens --input {input} --output {output} --manifest-output {manifest_output} --front-yaw-degrees 0 --profile auto --use-transfer" \
    AVATAR_RESKIN_COMMAND="python /app/tools/avatar/reskin_runner.py --skintokens-repo /models/SkinTokens --input {input} --output {output} --profile {profile} --manifest-output {manifest_output} --profile-mode auto --use-transfer" \
    KLEIN_4B_MODEL_PATH=/models/flux2/flux-2-klein-4b.safetensors \
    AE_MODEL_PATH=/models/flux2/ae.safetensors \
    FLUX2_TEXT_ENCODER_PATH=/models/flux2/Qwen3-4B \
    TRELLIS2_MODEL_PATH=/models/trellis2 \
    TRELLIS2_ALLOW_MODEL_DOWNLOAD=0 \
    PYTHONPATH=/app/src:/opt/TRELLIS.2:/opt/flux2

RUN mkdir -p /models/trellis2 /models/flux2 /models/SkinTokens \
    && chown -R avatar:avatar /models

USER avatar
