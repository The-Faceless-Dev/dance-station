# Small source-only release overlay for an existing model-bearing TRELLIS.2
# image. Use this for canonical skeleton, TokenRig, and reskin code changes so
# the large Flux/TRELLIS/SkinTokens model layers stay cached.
# syntax=docker/dockerfile:1.7

ARG TRELLIS2_BASE_IMAGE=ghcr.io/the-faceless-dev/faceless-avatar-trellis-worker:trellis2-salad-20260808-r10
FROM ${TRELLIS2_BASE_IMAGE}

USER root
WORKDIR /app

COPY --chown=avatar:avatar pyproject.toml README.md ./
COPY --chown=avatar:avatar src ./src
COPY --chown=avatar:avatar tools ./tools
COPY --chown=avatar:avatar containers/avatar-worker/faceless-avatar-entrypoint.sh /app/faceless-avatar-entrypoint.sh
COPY --chown=avatar:avatar containers/avatar-worker/faceless-avatar-startup-diagnostic.sh /app/faceless-avatar-startup-diagnostic.sh

RUN chmod 0755 /app/faceless-avatar-entrypoint.sh /app/faceless-avatar-startup-diagnostic.sh \
    && rm -f /app/src/autotransition/avatar/prompts.py \
    && test -f /app/src/autotransition/avatar/canonical_skeleton.py \
    && test -f /app/src/autotransition/avatar/reskin_pipeline.py \
    && test -f /app/tools/avatar/rig_runner.py \
    && test -f /app/tools/avatar/reskin_runner.py \
    && test -f /app/tools/tokenrig/adaptive_runner.py

ENV PYTHONPATH=/app/src:/opt/TRELLIS.2:/opt/flux2 \
    AVATAR_GPU_REQUIRED=1 \
    AVATAR_ARTIFACT_ROOT=/var/lib/faceless/avatar-jobs \
    AVATAR_MAX_ATTEMPTS=3 \
    AVATAR_REQUIRE_DEFORMATION_VALIDATOR=1 \
    AVATAR_MESH_MODEL_REVISION=trellis.2-4b \
    AVATAR_IMAGE_COMMAND="python /app/tools/avatar/flux2_klein_generate.py --prompt-file {prompt_file} --negative-prompt-file {negative_prompt_file} --output {output} --seed {seed} --reference-image {reference_image}" \
    AVATAR_MESH_COMMAND="python /app/tools/avatar/trellis2_generate.py --image {image} --output-dir {output_dir} --output {output} --quality {quality}" \
    AVATAR_RIG_COMMAND="python /app/tools/avatar/rig_runner.py --skintokens-repo /models/SkinTokens --input {input} --output {output} --manifest-output {manifest_output} --front-yaw-degrees 0 --profile auto --use-transfer" \
    AVATAR_RESKIN_COMMAND="python /app/tools/avatar/reskin_runner.py --skintokens-repo /models/SkinTokens --input {input} --output {output} --profile {profile} --manifest-output {manifest_output} --profile-mode auto --use-transfer" \
    TRELLIS2_MODEL_PATH=/models/trellis2 \
    KLEIN_4B_MODEL_PATH=/models/flux2/flux-2-klein-4b.safetensors \
    AE_MODEL_PATH=/models/flux2/ae.safetensors \
    FLUX2_TEXT_ENCODER_PATH=/models/flux2/Qwen3-4B \
    TRELLIS2_ALLOW_MODEL_DOWNLOAD=0 \
    TRELLIS2_PIPELINE_TYPE=1024 \
    TORCH_CUDA_ARCH_LIST=8.6 \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    WORKER_HOST=0.0.0.0 \
    WORKER_PORT=8080

USER avatar
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/app/faceless-avatar-entrypoint.sh"]
