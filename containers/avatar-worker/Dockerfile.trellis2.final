# Final model-bearing image metadata layer. The large model files are
# provisioned into the parent image separately so normal source builds never
# copy multi-gigabyte checkpoints into a build context.
FROM ghcr.io/the-faceless-dev/faceless-avatar-worker:trellis2-provisioned-20260804-r8

LABEL org.opencontainers.image.source="https://github.com/The-Faceless-Dev/dance-station" \
      org.opencontainers.image.title="Faceless Dancer Avatar Worker" \
      org.opencontainers.image.description="Model-bearing TRELLIS.2 avatar generation worker"

USER avatar

CMD ["autotransition", "avatar-worker", "--host", "0.0.0.0", "--port", "8090"]
