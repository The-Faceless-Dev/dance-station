# TRELLIS.2 avatar worker profile.
# The existing Dockerfile remains the Stable Fast 3D rollback image.
ARG TRELLIS2_COMMIT=75fbf0183001ed9876c8dbb35de6b68552ee08bd
ARG SKINTOKENS_COMMIT=273b691d35989d71cd17ff2895fdc735097b92d1
ARG TORCH_CUDA_ARCH_LIST=8.6
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel

ARG TORCH_CUDA_ARCH_LIST

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MAX_JOBS=2 \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
    NINJAFLAGS=-j2 \
    PYTHONPATH=/app/src:/opt/TRELLIS.2 \
    AVATAR_ARTIFACT_ROOT=/var/lib/faceless/avatar-jobs \
    AVATAR_MAX_ATTEMPTS=3 \
    AVATAR_REQUIRE_DEFORMATION_VALIDATOR=1 \
    AVATAR_GPU_REQUIRED=1 \
    AVATAR_MESH_MODEL_REVISION=trellis.2-4b \
    AVATAR_IMAGE_COMMAND="python /app/tools/avatar/flux2_klein_generate.py --prompt-file {prompt_file} --negative-prompt-file {negative_prompt_file} --output {output} --seed {seed} --reference-image {reference_image}" \
    AVATAR_MESH_COMMAND="python /app/tools/avatar/trellis2_generate.py --image {image} --output-dir {output_dir} --output {output} --quality {quality}" \
    AVATAR_RIG_COMMAND="python /app/tools/tokenrig/adaptive_runner.py --skintokens-repo /models/SkinTokens --input {input} --output {output} --manifest-output {manifest_output} --profile auto --use-transfer" \
    TRELLIS2_MODEL_PATH=/models/trellis2 \
    KLEIN_4B_MODEL_PATH=/models/flux2/flux-2-klein-4b.safetensors \
    AE_MODEL_PATH=/models/flux2/ae.safetensors \
    FLUX2_TEXT_ENCODER_PATH=/models/flux2/Qwen3-4B \
    TRELLIS2_ALLOW_MODEL_DOWNLOAD=0 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        ffmpeg \
        git \
        libjpeg-dev \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY tools ./tools

RUN python -m pip install --no-cache-dir --no-deps . \
    && python -m pip install --no-cache-dir \
        "fastapi>=0.115.0" \
        "python-multipart>=0.0.20" \
        "typer>=0.12.0" \
        "uvicorn>=0.32.0" \
        "accelerate>=1.12.0" \
        "easydict>=1.13" \
        "imageio>=2.37.0" \
        "imageio-ffmpeg>=0.5.1" \
        "opencv-python-headless>=4.10.0" \
        "pillow>=11.0.0" \
        "plyfile>=1.1.2" \
        "trimesh>=4.6.0" \
        "transformers>=4.51.0" \
        "tqdm>=4.67.0" \
        "zstandard>=0.23.0" \
        "kornia>=0.8.0" \
        "timm>=1.0.0" \
        "transformers>=4.57.0" \
        "python-box" \
        "omegaconf" \
        "lightning" \
        "addict" \
        "fast-simplification" \
        "bpy>=4.2" \
        "open3d" \
        "gradio" \
        "bottle" \
        "tornado" \
        "git+https://github.com/EasternJournalist/utils3d.git@9a4eb15e4021b67b12c460c7057d642626897ec8" \
    && python -m pip install --no-cache-dir --no-build-isolation "flash-attn==2.7.3"

ARG TRELLIS2_COMMIT
RUN git clone --recursive https://github.com/microsoft/TRELLIS.2.git /opt/TRELLIS.2 \
    && git -C /opt/TRELLIS.2 checkout --detach "${TRELLIS2_COMMIT}" \
    && git -C /opt/TRELLIS.2 submodule update --init --recursive \
    && python -m pip install --no-cache-dir --no-build-isolation /opt/TRELLIS.2/o-voxel

# These are the CUDA extensions required by the official TRELLIS.2 pipeline
# and GLB postprocessor. They are compiled into the image, not during jobs.
RUN git clone --recursive https://github.com/JeffreyXiang/CuMesh.git /tmp/CuMesh \
    && python -m pip install --no-cache-dir --no-build-isolation /tmp/CuMesh \
    && git clone --recursive https://github.com/JeffreyXiang/FlexGEMM.git /tmp/FlexGEMM \
    && python -m pip install --no-cache-dir --no-build-isolation /tmp/FlexGEMM \
    && git clone -b v0.4.0 https://github.com/NVlabs/nvdiffrast.git /tmp/nvdiffrast \
    && python -m pip install --no-cache-dir --no-build-isolation /tmp/nvdiffrast \
    && rm -rf /tmp/CuMesh /tmp/FlexGEMM /tmp/nvdiffrast

ARG FLUX2_COMMIT=50fe5162777813d869182b139e83b10743caef15
RUN git clone https://github.com/black-forest-labs/flux2.git /opt/flux2 \
    && git -C /opt/flux2 checkout --detach "${FLUX2_COMMIT}" \
    && python -m pip install --no-cache-dir --no-deps /opt/flux2

ARG SKINTOKENS_COMMIT
RUN git clone https://github.com/VAST-AI-Research/SkinTokens.git /opt/SkinTokens \
    && git -C /opt/SkinTokens checkout --detach "${SKINTOKENS_COMMIT}" \
    && rm -rf /opt/SkinTokens/.git

RUN useradd --create-home --uid 10001 avatar \
    && mkdir -p /var/lib/faceless/avatar-jobs /models /runtimes \
    && chown -R avatar:avatar /app /var/lib/faceless/avatar-jobs
USER avatar

EXPOSE 8090
CMD ["autotransition", "avatar-worker", "--host", "0.0.0.0", "--port", "8090"]
