@@ -0,0 +1,78 @@
+#ifndef __SD_MODEL_VAE_QWEN_TENSOR_DIAGNOSTICS_HPP__
+#define __SD_MODEL_VAE_QWEN_TENSOR_DIAGNOSTICS_HPP__
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <limits>
+#include <string>
+
+#include "core/tensor.hpp"
+#include "core/util.h"
+
+namespace qwen_tensor_diagnostics {
+
+inline bool enabled() {
+    const char* value = std::getenv("SD_QWEN_TENSOR_DIAGNOSTICS");
+    if (value == nullptr) {
+        return false;
+    }
+    return value[0] == '1' || value[0] == 'y' || value[0] == 'Y' || value[0] == 't' || value[0] == 'T';
+}
+
+inline void log(const char* stage, const sd::Tensor<float>& tensor) {
+    if (!enabled()) {
+        return;
+    }
+
+    const int64_t total = tensor.numel();
+    int64_t finite_count = 0;
+    int64_t nan_count = 0;
+    int64_t inf_count = 0;
+    long double sum = 0.0L;
+    long double sum_squares = 0.0L;
+    float minimum = std::numeric_limits<float>::infinity();
+    float maximum = -std::numeric_limits<float>::infinity();
+
+    for (int64_t index = 0; index < total; ++index) {
+        const float value = tensor[index];
+        if (std::isnan(value)) {
+            ++nan_count;
+        } else if (std::isinf(value)) {
+            ++inf_count;
+        } else {
+            ++finite_count;
+            minimum = std::min(minimum, value);
+            maximum = std::max(maximum, value);
+            sum += static_cast<long double>(value);
+            sum_squares += static_cast<long double>(value) * static_cast<long double>(value);
+        }
+    }
+
+    const double mean = finite_count == 0 ? 0.0 : static_cast<double>(sum / finite_count);
+    const double mean_square = finite_count == 0 ? 0.0 : static_cast<double>(sum_squares / finite_count);
+    const double variance = std::max(0.0, mean_square - mean * mean);
+    const double standard_deviation = std::sqrt(variance);
+    if (finite_count == 0) {
+        minimum = 0.0f;
+        maximum = 0.0f;
+    }
+
+    const std::string shape = sd::tensor_shape_to_string(tensor.shape());
+    LOG_INFO(
+        "[qwen-tensor] stage=%s shape=%s numel=%lld finite=%lld nan=%lld inf=%lld min=%.9g max=%.9g mean=%.9g std=%.9g",
+        stage,
+        shape.c_str(),
+        static_cast<long long>(total),
+        static_cast<long long>(finite_count),
+        static_cast<long long>(nan_count),
+        static_cast<long long>(inf_count),
+        static_cast<double>(minimum),
+        static_cast<double>(maximum),
+        mean,
+        standard_deviation);
+}
+
+}  // namespace qwen_tensor_diagnostics
+
+#endif  // __SD_MODEL_VAE_QWEN_TENSOR_DIAGNOSTICS_HPP__
